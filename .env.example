# Public base path for GitHub Pages project site
NEXT_PUBLIC_BASE_PATH=/chemical-system

# Optional form endpoint (Formspree, Web3Forms, etc.)
# When set, contact and quote forms POST JSON/form-urlencoded to this URL.
# When unset, forms fall back to mailto:office.cscm@gmail.com
# Example Formspree: https://formspree.io/f/xxxxxxxx
# Example Web3Forms: https://api.web3forms.com/submit (also set access_key in the form)
NEXT_PUBLIC_FORM_ENDPOINT=
